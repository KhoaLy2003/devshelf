{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DevShelf",
  "version": "0.3.0",
  "identifier": "app.devshelf.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "DevShelf",
        "width": 1100,
        "height": 720,
        "minWidth": 960,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDMyQkU2NTY5RjE2QUI4NTkKUldSWnVHcnhhV1crTWlpRGpSVzFOMFdXK1E1RUtTU0kycnVNd3VsbXM4bkhhZEh1eGtwQ2xCRGoK",
      "endpoints": ["https://github.com/KhoaLy2003/devshelf/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  }
}
